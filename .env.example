# Copy to .env (optional: every value has the same default in docker-compose.yml).
# These are LOCAL-ONLY development credentials. Never reuse them anywhere real.

# Airflow web UI login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Airflow metadata database (Postgres container)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Host port for the Airflow UI
AIRFLOW_PORT=8080

# Linux UID that owns files created by the containers (leave as is on Docker Desktop)
AIRFLOW_UID=50000

# Secret used by the Airflow webserver to sign sessions (change if you expose it)
AIRFLOW_SECRET_KEY=local-dev-only-change-me
